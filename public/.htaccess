RewriteEngine On



# Quitar el www → redirigir a https://patxi-pintor.com/
RewriteCond %{HTTP_HOST} ^www\.patxi\-pintor\.com$ [NC]
RewriteRule ^(.*)$ https://patxi-pintor.com/$1 [R=301,L]

# El hosting ya fuerza HTTPS. Los destinos absolutos evitan que su proxy
# genere una vuelta a HTTP al normalizar las barras finales.
RewriteCond %{HTTP_HOST} ^patxi-pintor\.com$ [NC]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://patxi-pintor.com/$1 [R=301,L]

# Mantener el funcionamiento local sin enviar localhost a producción.
RewriteCond %{HTTP_HOST} !^(www\.)?patxi-pintor\.com$ [NC]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Ocultar index.php solo cuando se solicita desde el navegador.
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteCond %{HTTP_HOST} ^patxi-pintor\.com$ [NC]
RewriteRule ^index\.php$ https://patxi-pintor.com/ [R=301,L]

# que no cuente como url los files y directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

#Evitar descarga de archivos en esta carpeta con una redirección 403
# RedirectMatch 403 ^../App/files/.*$

# carga ese archivo como enroutador
RewriteRule ^ index.php [L,QSA]


# reglas de seguridad de apache SÓLO PARA DINAHOSTING
<IfModule mod_security2.c>
	SecRuleRemoveById 201 210580 211220 211230 214940 218130
</IfModule>

